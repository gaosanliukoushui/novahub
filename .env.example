# NovaHub local demo environment.
# Copy to .env only if you want to override Docker Compose defaults.

DB_USER=novahub
DB_PASS=root123
DB_SLAVE_USER=novahub
DB_SLAVE_PASS=root123

JWT_SECRET=NovaHub2024SecretKeyForJwtTokenGenerationMustBeLongEnough256bits!
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

REDIS_PASSWORD=
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=nova-hub

ES_HOST=elasticsearch
ES_PORT=9200
ES_SCHEME=http

OUTBOX_DISPATCH_ENABLED=true
